# 복사해서 .env로 만든다. 아래 값은 로컬 학습용 예시다(README "실행"의 Docker PostgreSQL과 맞춤). .env는 커밋하지 않는다.

# PostgreSQL 접속 주소 (asyncpg 드라이버)
DATABASE_URL=postgresql+asyncpg://matchmaking:matchmaking@localhost:5432/matchmaking

# JWT 서명 비밀키 (충분히 긴 임의 문자열)
JWT_SECRET_KEY=local-dev-jwt-secret-key-for-study-only-0001

# 토큰 유효 기간: access 토큰(분), refresh 토큰(일)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 허용 출처 (JSON 배열)
CORS_ORIGINS=["http://localhost:8000"]

# DB 커넥션 풀
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# 시드 회원(seed01~seed14) 공통 비밀번호 (8자 이상)
SEED_USER_PASSWORD=seedpass1234

# 테스트 전용 (앱 설정은 읽지 않음): 테스트용 별도 PostgreSQL DB
# TEST_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<test_db>
