# 복사해서 .env로 만든 뒤 값을 채운다. .env는 커밋하지 않는다. (ADR-003)

# PostgreSQL 접속 주소 (asyncpg 드라이버)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<db>

# JWT 서명 비밀키 (충분히 긴 임의 문자열)
JWT_SECRET_KEY=

# 토큰 만료 시간(분), 기본 60
JWT_EXPIRE_MINUTES=60

# CORS 허용 출처 (JSON 배열)
CORS_ORIGINS=["http://localhost:8000"]

# 로그인 쿠키 Secure 속성 (HTTPS에서만 true)
COOKIE_SECURE=false

# DB 커넥션 풀
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# 시드 회원(seed01~seed14) 공통 비밀번호 (8자 이상)
SEED_USER_PASSWORD=

# 테스트 전용 (앱 설정은 읽지 않음): 테스트용 별도 PostgreSQL DB
# TEST_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<test_db>
