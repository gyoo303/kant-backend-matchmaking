# .env.local로 복사해 값을 채운다. 이 파일에는 값을 넣지 않는다 (ADR-005).
# NEXT_PUBLIC_ 변수는 브라우저에 노출된다. 비밀값에는 붙이지 않는다.

# Supabase 원격 프로젝트 URL (lib/supabase/client.ts, server.ts)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable 키, 공개 (lib/supabase/client.ts, server.ts)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase service role 키, 비밀 (lib/supabase/admin.ts만)
SUPABASE_SERVICE_ROLE_KEY=

# 토스페이먼츠 테스트 클라이언트 키, 공개 (결제창)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 토스페이먼츠 테스트 시크릿 키, 비밀 (lib/payments/toss.ts만)
TOSS_SECRET_KEY=

# 네이버 로그인 앱 키, 비밀 (lib/auth/naver.ts만, ADR-003 B로 전환 시)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 사이트 주소, 공개 (콜백·리다이렉트 URL 생성). 로컬: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
